      "target": "tnas",
      "timeout_min": 5,
      "enabled": true,
      "critical": false
    },
    {
      "id": "wake-ubuntu",
      "type": "machine_wake",
      "label": "Wake ai-server",
      "target": "ubuntu",
      "timeout_min": 5,
      "enabled": true,
      "critical": true
